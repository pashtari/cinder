# --- job output: slurm logs, checkpoints, run artifacts ---
logs/

# --- staged PyPI wheels: a build artifact, rebuilt by prefetch_wheels.sh ---
# scripts/hpc/ itself IS tracked -- the job scripts are project artifacts and
# git is how they reach the cluster. Only the wheel cache is excluded.
scripts/hpc/wheels/

# --- datasets live on scratch, never in the repo ---
data/
*.pth
*.ckpt
*.pt

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
*.so
.venv/
venv/

# --- build / distribution ---
build/
dist/
.eggs/

# --- test / tooling caches ---
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- IDE ---
.vscode/
.idea/

# --- machine-local agent settings ---
.claude/settings.local.json

# --- OS ---
.DS_Store
Thumbs.db

# --- unwanted folders ---
.trash/
